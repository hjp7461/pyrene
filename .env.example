# Application user (read+write to public schema, used for migrations only)
PG_DSN=postgresql+asyncpg://pyrene:pyrene@localhost:5433/dvdrental

# Read-only role (used by run_select tool — F-03 두 번째 방어선)
PG_READONLY_DSN=postgresql+asyncpg://pyrene_readonly:readonly@localhost:5433/dvdrental

# LLM — Pydantic AI model identifier (provider:model)
MODEL_NAME=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Schema-RAG indexer (PRD-002). Required for `pyrene-sql index-schema`.
OPENAI_API_KEY=

# Observability (PRD-006)
LOGFIRE_TOKEN=
LOGFIRE_PROJECT_NAME=pyrene-sql

# Auth (PRD-007, PLAN-007) — JWT settings. JWT_SECRET MUST be overridden
# in production with 32+ bytes of high-entropy randomness. The default is
# only safe for local dev.
JWT_SECRET=pyrene-dev-secret-change-me-with-at-least-thirty-two-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Auth bootstrap (used by `pyrene-auth init-admin` CLI)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme-locally-only
